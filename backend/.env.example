# ---- Database (MySQL) ----
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/eventsync

# ---- Security: put any long random text here ----
JWT_SECRET_KEY=

# ---- URLs ----
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
UPLOAD_DIRECTORY=./uploads

# ---- Email (OTP codes + tickets). Leave SMTP_HOST empty to just print emails in this terminal. ----
# Gmail: turn on 2-step verification, create an "App password" at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=EventSync

# ---- Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys; use Test Mode keys first) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# optional: only if you create a webhook (event: payment.captured) pointing to /api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ---- Optional ----
GOOGLE_CLIENT_ID=
AI_API_KEY=

# Set to 1 for hosted MySQL (Aiven etc.) that requires an encrypted connection
DB_SSL=
